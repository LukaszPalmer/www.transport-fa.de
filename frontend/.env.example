# ---------------------------------------------------------------------------
# FA Transport – Umgebungsvariablen (Vorlage)
# Kopieren nach .env.local (Entwicklung) bzw. im Hosting hinterlegen.
# ---------------------------------------------------------------------------

# Öffentliche URL der Website (Canonical, Sitemap, OG, E-Mail-Links)
NEXT_PUBLIC_SITE_URL=https://www.transport-fa.de

# Anmeldung, Sitzungen und Google-Login laufen über das Backend (backend/.env) –
# siehe NEXT_PUBLIC_API_URL / API_INTERNAL_URL unten.

# --- Google Maps (Tracking-App-Sektion, optional) ----------------------------
# Nur „Maps JavaScript API“ aktivieren; Key auf HTTP-Referrer der Domain beschränken.
# Ohne Key zeigt die Sektion die statische Karte (keine Verbindung zu Google).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- E-Mail-Versand (Kontakt- und Bewerbungsformular) ----- ------------------
# Ohne SMTP_HOST werden E-Mails in der Entwicklung nur in der Konsole ausgegeben.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Absender = Postfach des SMTP-Zugangs (IONOS lehnt fremde Absender ab)
MAIL_FROM="FA Transport <kontakt@transport-fa.de>"
# Empfänger im Unternehmen
MAIL_TO_CONTACT=kontakt@transport-fa.de
MAIL_TO_CAREERS=kontakt@transport-fa.de

# --- Backend-API (backend/) ---------------------------------------------------
# Öffentliche API-URL für Browser & Socket.io – Produktion: https://api.transport-fa.de
NEXT_PUBLIC_API_URL=http://localhost:4000
# Interne URL für Server Components – Railway: http://<backend-service>.railway.internal:4000
API_INTERNAL_URL=http://localhost:4000

# --- Karte (MapLibre, Sendungsverfolgung) ---------------------------------------
# Stil-URL der Vektorkarte. Entwicklung: OpenFreeMap (ohne Schlüssel, ohne Cookies).
# Vor dem Livegang: eigene Kacheln (Protomaps) über die API oder EU-Anbieter.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
