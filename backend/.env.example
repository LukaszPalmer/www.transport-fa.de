# ---------------------------------------------------------------------------
# FA Transport API – Umgebungsvariablen (Vorlage)
# Lokal: nach backend/.env kopieren. Produktion: als Railway-Service-Variablen.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend-URL (E-Mail-Links, CORS) – Produktion: https://www.transport-fa.de
FRONTEND_URL=http://localhost:3000
# Öffentliche API-URL (OAuth-Callback, Links) – Produktion: https://api.transport-fa.de
API_PUBLIC_URL=http://localhost:4000
# Weitere erlaubte Origins, kommagetrennt (z. B. Staging) – optional
CORS_ORIGINS=
# Cookie-Domain für www + api – Produktion: transport-fa.de · lokal leer lassen
COOKIE_DOMAIN=

# --- MongoDB Atlas ------------------------------------------------------------
# Atlas → Database → Connect → Drivers → Verbindungs-URI (mongodb+srv://…)
MONGODB_URI=
# Lokal: fa-transport-dev · Produktion: fa-transport
MONGODB_DB_NAME=fa-transport-dev

# --- Sicherheit -----------------------------------------------------------------
# Verschlüsselt die 2FA-Secrets der Admins (32 Byte, Base64).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Produktion: EIGENEN Wert erzeugen, nie den lokalen wiederverwenden.
MFA_ENCRYPTION_KEY=

# --- Google OAuth 2.0 ------------------------------------------------------------
# Google Cloud → Projekt "FA Transport Portal" → Google Auth Platform → Clients → "FA Transport API"
# Weiterleitungs-URI (dort eingetragen): <API_PUBLIC_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 --------------------------------------------------------------
# R2 → Manage API Tokens → Account API Token, "Object Read & Write", nur dieser Bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fa-transport-documents
# Bucket-Jurisdiktion: eu → Endpoint <account>.eu.r2.cloudflarestorage.com
R2_JURISDICTION=eu
# Öffentlicher Bucket/Domain für die Kartenkacheln (MapLibre/Protomaps)
R2_TILES_PUBLIC_URL=

# --- E-Mail: Resend, SMTP als Fallback --------------------------------------------
# Resend → API Keys. Produktion: Key mit "Sending access", beschränkt auf transport-fa.de
# MAIL_PROVIDER: console (nur Log, Entwicklung) · resend · smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="FA Transport <kontakt@transport-fa.de>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Routen & ETA (folgt) -------------------------------------------------------------
OPENROUTESERVICE_API_KEY=

# --- CRM: Anfragen aus dem Kontaktformular ------------------------------------------
# Gemeinsames Geheimnis mit dem Frontend (gleicher Wert in frontend LEAD_INGEST_TOKEN).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Produktion: Pflicht – ohne Wert nimmt die API keine Anfragen an (sie gehen dann nur per E-Mail ein).
LEAD_INGEST_TOKEN=
