{
  "name": "@fa/backend",
  "version": "0.1.0",
  "private": true,
  "description": "FA Transport API – Express, Socket.io, MongoDB (Mongoose), Cloudflare R2.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsdown",
    "start": "node dist/server.js",
    "db:sync-indexes": "tsx scripts/sync-indexes.ts",
    "db:sync-indexes:prod": "node dist/sync-indexes.js",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "storage:check": "tsx scripts/check-storage.ts",
    "storage:check:prod": "node dist/check-storage.js",
    "mail:preview": "tsx scripts/mail-preview.ts",
    "invoice:preview": "tsx scripts/invoice-preview.ts",
    "admin": "tsx scripts/admin.ts",
    "chat:load-test": "tsx scripts/chat-load-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-storage": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@fa/shared": "*",
    "arctic": "^3.7.0",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
